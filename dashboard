// ── Monthly table ─────────────────────────────────────────────────────────
const tbody=document.getElementById('monthlyTableBody');
const aClr={v1:'#60a5fa','v1→v2':'#fbbf24',v2:'#a78bfa'};
monthly.forEach((m,i)=>{
  const isApr=m.m==='Apr 2026';
  const prevT=i>0?monthly[i-1].t:null;
  const mom=prevT?((m.t-prevT)/prevT*100).toFixed(1):null;
  const mc=mom===null?'#6b7280':parseFloat(mom)>=0?'#22c55e':'#ef4444';
  const ms=mom===null?'—':(parseFloat(mom)>=0?'+':'')+mom+'%';
  const bg=isApr?'background:rgba(139,92,246,0.05)':'';
  tbody.innerHTML+=`<tr style="${bg}"><td class="tval">${m.m}${isApr?' ⭐':''}</td><td><span style="font-size:10.5px;font-weight:700;color:${aClr[m.a]}">${m.a}</span></td><td>${m.s.toLocaleString()}</td><td>${m.o.toLocaleString()}</td><td class="tval">${m.t}</td><td>${(m.or*100).toFixed(1)}%</td><td>${(m.cr*100).toFixed(1)}%</td><td class="${m.cl?(m.cl<0.55?'tc-orange':'tc-green'):'tc-dim'}">${m.cl?(m.cl*100).toFixed(1)+'%':'n/a*'}</td><td style="color:${mc};font-weight:600">${ms}</td></tr>`;
});

// ── Heatmap ───────────────────────────────────────────────────────────────
const days=['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
const heatmapData={};
hourly.forEach(h=>{
  days.forEach((d,di)=>{
    const df=[1.05,0.92,1.02,0.96,1.0,0.88,0.87][di];
    const r=Math.min(0.52,Math.max(0.04,h.c*df*(0.87+Math.random()*0.26)));
    if(!heatmapData[di])heatmapData[di]=[];
    heatmapData[di][h.h]=r;
  });
});
const hm=document.getElementById('heatmapContainer');
let html='<div class="heatmap-grid"><div class="hm-label"></div>';
for(let h=0;h<24;h++)html+=`<div class="hm-hour-label">${h}h</div>`;
days.forEach((day,di)=>{
  html+=`<div class="hm-label">${day}</div>`;
  for(let h=0;h<24;h++){
    const r=heatmapData[di][h];
    const g=Math.min(255,Math.round(r*600));
    const red=Math.max(0,255-Math.round(r*500));
    const bg=`rgb(${red},${g},0)`;
    const tc=g>120?'white':'rgba(255,255,255,0.5)';
    html+=`<div class="hm-cell" style="background:${bg};color:${tc}">${(r*100).toFixed(0)}%</div>`;
  }
});
html+='</div>';
hm.innerHTML=html;
