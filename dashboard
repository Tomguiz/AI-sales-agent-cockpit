<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Orange Belgium — B2C WhatsApp AI Cockpit | April 2026</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
  <style>
    :root {
      --orange:#FF6200;--orange-light:#FF8433;--orange-dim:rgba(255,98,0,0.12);--orange-glow:rgba(255,98,0,0.28);
      --bg:#090b14;--surface:#111527;--surface2:#181d35;--surface3:#1e2540;
      --border:rgba(255,255,255,0.07);--border2:rgba(255,255,255,0.13);
      --text:#f0f4ff;--text2:rgba(240,244,255,0.62);--text3:rgba(240,244,255,0.34);
      --success:#22c55e;--success-dim:rgba(34,197,94,0.12);
      --warning:#f59e0b;--warning-dim:rgba(245,158,11,0.12);
      --danger:#ef4444;--danger-dim:rgba(239,68,68,0.12);
      --info:#3b82f6;--info-dim:rgba(59,130,246,0.12);
      --v2:#8b5cf6;--v2-dim:rgba(139,92,246,0.12);
    }
    *{margin:0;padding:0;box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{font-family:'Inter',-apple-system,sans-serif;background:var(--bg);color:var(--text);font-size:13.5px;line-height:1.55}

    /* NAV */
    .topbar{position:sticky;top:0;z-index:100;background:rgba(9,11,20,0.94);backdrop-filter:blur(18px);border-bottom:1px solid var(--border2);padding:0 24px;display:flex;align-items:center;height:56px}
    .logo-area{display:flex;align-items:center;gap:11px;margin-right:28px;flex-shrink:0}
    .logo-badge{width:33px;height:33px;border-radius:9px;background:linear-gradient(135deg,var(--orange),var(--orange-light));display:flex;align-items:center;justify-content:center;font-weight:800;font-size:12px;color:#fff;box-shadow:0 0 14px var(--orange-glow)}
    .logo-text{font-weight:700;font-size:13.5px;letter-spacing:-0.2px}
    .logo-sub{font-size:10.5px;color:var(--text3)}
    .nav-tabs{display:flex;align-items:center;gap:2px;flex:1;overflow-x:auto}
    .nav-tab{padding:6px 14px;border-radius:8px;cursor:pointer;font-size:12.5px;font-weight:500;color:var(--text2);transition:all 0.17s;border:none;background:none;white-space:nowrap}
    .nav-tab:hover{background:var(--surface2);color:var(--text)}
    .nav-tab.active{background:var(--orange-dim);color:var(--orange-light);box-shadow:inset 0 0 0 1px var(--orange-glow)}
    .nav-right{margin-left:auto;display:flex;align-items:center;gap:9px;flex-shrink:0;padding-left:16px}
    .badge-date{font-size:11px;color:var(--text3);font-weight:500;border:1px solid var(--border2);padding:4px 10px;border-radius:20px}
    .badge-live{display:flex;align-items:center;gap:5px;font-size:11px;font-weight:600;color:var(--success);border:1px solid rgba(34,197,94,0.22);padding:4px 10px;border-radius:20px;background:var(--success-dim)}
    .dot-live{width:6px;height:6px;border-radius:50%;background:var(--success);animation:pulse 2s ease infinite}
    @keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:0.5;transform:scale(0.8)}}

    /* SECTIONS */
    .section{display:none;padding:26px 26px 52px;max-width:1440px;margin:0 auto}
    .section.active{display:block}

    /* HERO */
    .hero{border-radius:16px;background:linear-gradient(135deg,rgba(255,98,0,0.07) 0%,rgba(139,92,246,0.05) 100%);border:1px solid rgba(255,98,0,0.17);padding:26px 30px;margin-bottom:22px;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}
    .hero-left h1{font-size:21px;font-weight:800;letter-spacing:-0.5px;background:linear-gradient(90deg,#fff 0%,var(--orange-light) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:4px}
    .hero-left p{color:var(--text2);font-size:12.5px}
    .hero-right{display:flex;gap:10px;flex-wrap:wrap}
    .hero-badge{padding:5px 13px;border-radius:20px;font-size:11.5px;font-weight:600;border:1px solid}
    .hero-badge.v2{background:var(--v2-dim);color:#a78bfa;border-color:rgba(139,92,246,0.25)}
    .hero-badge.alert{background:var(--warning-dim);color:var(--warning);border-color:rgba(245,158,11,0.28)}
    .hero-badge.green{background:var(--success-dim);color:var(--success);border-color:rgba(34,197,94,0.25)}

    /* KPI GRID */
    .kpi-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:13px;margin-bottom:22px}
    .kpi-card{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:18px 16px;position:relative;overflow:hidden;transition:border-color 0.2s,transform 0.2s;cursor:default}
    .kpi-card:hover{border-color:var(--border2);transform:translateY(-1px)}
    .kpi-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--accent,var(--orange));border-radius:14px 14px 0 0}
    .kpi-label{font-size:10.5px;font-weight:600;color:var(--text3);text-transform:uppercase;letter-spacing:0.6px;margin-bottom:9px}
    .kpi-value{font-size:27px;font-weight:800;letter-spacing:-1px;color:var(--text);margin-bottom:5px}
    .kpi-value .kpi-proj{font-size:14px;font-weight:500;color:var(--text3);letter-spacing:0}
    .kpi-sub{font-size:11.5px;color:var(--text2)}
    .kpi-delta{display:inline-flex;align-items:center;gap:3px;font-size:11px;font-weight:600;padding:2px 8px;border-radius:20px;margin-top:6px}
    .delta-up{background:var(--success-dim);color:var(--success)}
    .delta-down{background:var(--danger-dim);color:var(--danger)}
    .delta-neutral{background:var(--info-dim);color:#60a5fa}
    .delta-warn{background:var(--warning-dim);color:var(--warning)}

    /* LAYOUT ROWS */
    .row-2{display:grid;grid-template-columns:1fr 1fr;gap:17px;margin-bottom:22px}
    .row-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:17px;margin-bottom:22px}
    .row-65{display:grid;grid-template-columns:1.7fr 1fr;gap:17px;margin-bottom:22px}
    .row-full{margin-bottom:22px}

    /* CARDS */
    .card{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:20px 20px;transition:border-color 0.2s}
    .card:hover{border-color:var(--border2)}
    .card-title{font-size:13px;font-weight:700;color:var(--text);margin-bottom:3px;display:flex;align-items:center;gap:7px}
    .card-sub{font-size:11px;color:var(--text3);margin-bottom:16px}
    .chart-wrap{position:relative;height:210px}
    .chart-wrap-lg{position:relative;height:270px}
    .chart-wrap-sm{position:relative;height:170px}

    /* ALERT */
    .alert-box{border-radius:14px;padding:16px 20px;display:flex;align-items:flex-start;gap:14px;margin-bottom:22px}
    .alert-box.warning{background:rgba(245,158,11,0.07);border:1px solid rgba(245,158,11,0.23)}
    .alert-box.danger{background:rgba(239,68,68,0.07);border:1px solid rgba(239,68,68,0.23)}
    .alert-box.success{background:rgba(34,197,94,0.07);border:1px solid rgba(34,197,94,0.23)}
    .alert-box.info{background:rgba(59,130,246,0.07);border:1px solid rgba(59,130,246,0.23)}
    .alert-icon{font-size:22px;flex-shrink:0;margin-top:1px}
    .alert-body h3{font-size:13.5px;font-weight:700;margin-bottom:4px}
    .alert-body p{font-size:12px;color:var(--text2);line-height:1.65}
    .alert-body strong{color:var(--text)}

    /* TABLE */
    .data-table{width:100%;border-collapse:collapse}
    .data-table th{font-size:10px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:0.5px;padding:8px 11px;text-align:left;border-bottom:1px solid var(--border2)}
    .data-table td{padding:8px 11px;font-size:12.5px;color:var(--text2);border-bottom:1px solid var(--border)}
    .data-table tr:last-child td{border-bottom:none}
    .data-table tr:hover td{background:var(--surface2);color:var(--text)}
    .tval{color:var(--text);font-weight:600}
    .tc-green{color:var(--success);font-weight:600}
    .tc-red{color:var(--danger);font-weight:600}
    .tc-orange{color:var(--orange-light);font-weight:600}
    .tc-purple{color:#a78bfa;font-weight:600}
    .tc-dim{color:var(--text3)}
    .pill{display:inline-block;font-size:10px;font-weight:600;padding:2px 8px;border-radius:20px}

    /* HBARS */
    .hbar-row{display:flex;align-items:center;gap:10px;margin-bottom:9px}
    .hbar-label{font-size:11.5px;color:var(--text2);width:160px;flex-shrink:0}
    .hbar-track{flex:1;height:7px;background:var(--surface2);border-radius:20px;overflow:hidden}
    .hbar-fill{height:100%;border-radius:20px}
    .hbar-val{font-size:12px;font-weight:600;color:var(--text);width:70px;text-align:right;flex-shrink:0}

    /* VERSION CARDS */
    .version-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:13px;margin-bottom:22px}
    .version-card{border-radius:14px;padding:18px;border:1px solid var(--border);background:var(--surface);position:relative;overflow:hidden}
    .version-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--vc-accent,#3b82f6)}
    .vc-tag{display:inline-block;font-size:10.5px;font-weight:700;padding:2px 9px;border-radius:20px;margin-bottom:8px}
    .vc-period{font-size:11.5px;color:var(--text3);margin-bottom:12px}
    .vc-metrics{display:grid;grid-template-columns:1fr 1fr;gap:9px}
    .vc-m-val{font-size:19px;font-weight:800;letter-spacing:-0.5px}
    .vc-m-lbl{font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:0.4px}

    /* RECO CARDS */
    .reco-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}
    .reco-card{border-radius:16px;padding:22px;border:1px solid var(--border);background:var(--surface);position:relative;overflow:hidden}
    .reco-card::after{content:'';position:absolute;inset:0;border-radius:16px;background:radial-gradient(circle at top left,var(--glow,rgba(255,98,0,0.05)) 0%,transparent 70%);pointer-events:none}
    .reco-num{font-size:40px;font-weight:900;letter-spacing:-3px;line-height:1;color:var(--acc,var(--orange));opacity:0.2;position:absolute;top:14px;right:18px}
    .reco-icon{font-size:24px;margin-bottom:12px}
    .reco-badge{display:inline-block;font-size:9.5px;font-weight:700;padding:3px 9px;border-radius:20px;margin-bottom:10px;text-transform:uppercase;letter-spacing:0.5px}
    .reco-title{font-size:14.5px;font-weight:700;margin-bottom:7px}
    .reco-body{font-size:12px;color:var(--text2);line-height:1.72}
    .reco-action{margin-top:14px;padding:11px 14px;background:var(--surface2);border-radius:9px;font-size:11.5px;color:var(--text2);border:1px solid var(--border2)}
    .reco-action strong{color:var(--text)}

    /* DONUT LEGEND */
    .donut-row{display:flex;align-items:center;gap:6px;margin-bottom:7px}
    .donut-dot{width:9px;height:9px;border-radius:2px;flex-shrink:0}
    .donut-lbl{font-size:11.5px;color:var(--text2);flex:1}
    .donut-val{font-size:12px;font-weight:600;color:var(--text)}
    .donut-pct{font-size:10.5px;color:var(--text3);margin-left:5px}

    /* SECTION HDR */
    .section-hdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}
    .section-hdr h2{font-size:16px;font-weight:700;letter-spacing:-0.3px}
    .section-hdr .sh-note{font-size:11.5px;color:var(--text3)}

    /* CHIPS */
    .insight-chips{display:flex;flex-wrap:wrap;gap:7px;margin-top:14px}
    .chip{display:flex;align-items:center;gap:5px;background:var(--surface2);border:1px solid var(--border2);border-radius:7px;padding:6px 11px;font-size:11.5px;color:var(--text2)}

    /* STAT HIGHLIGHT */
    .stat-highlight{text-align:center;padding:18px 14px}
    .stat-highlight .sh-val{font-size:36px;font-weight:900;letter-spacing:-2px;margin-bottom:3px}
    .stat-highlight .sh-lbl{font-size:10.5px;font-weight:600;color:var(--text3);text-transform:uppercase;letter-spacing:0.5px}
    .stat-highlight .sh-sub{font-size:12px;color:var(--text2);margin-top:5px}

    /* DIVIDER */
    .divider{height:1px;background:var(--border);margin:18px 0}

    /* TABLE SCROLL */
    .table-scroll{overflow-x:auto}

    /* FEEDBACK QUOTE */
    .quote-card{background:var(--surface2);border:1px solid var(--border2);border-radius:10px;padding:12px 14px;margin-bottom:9px;font-size:12px;color:var(--text2);font-style:italic;line-height:1.65;position:relative;padding-left:24px}
    .quote-card::before{content:'"';position:absolute;left:10px;top:8px;font-size:20px;color:var(--orange);font-style:normal;line-height:1}

    /* SCORE BIG */
    .score-big{text-align:center;padding:24px 16px}
    .score-big .sc-num{font-size:52px;font-weight:900;letter-spacing:-3px;color:var(--success)}
    .score-big .sc-star{font-size:22px;letter-spacing:3px;margin:4px 0}
    .score-big .sc-lbl{font-size:11.5px;color:var(--text3);text-transform:uppercase;letter-spacing:0.5px}
    .score-big .sc-sub{font-size:12.5px;color:var(--text2);margin-top:6px}

    /* INTENT TAG */
    .intent-row{display:flex;align-items:center;gap:11px;padding:9px 0;border-bottom:1px solid var(--border)}
    .intent-row:last-child{border-bottom:none}
    .intent-emoji{font-size:18px;flex-shrink:0;width:28px;text-align:center}
    .intent-info{flex:1}
    .intent-name{font-size:12.5px;font-weight:600;color:var(--text)}
    .intent-desc{font-size:11px;color:var(--text3)}
    .intent-count{font-size:13px;font-weight:700;color:var(--text);text-align:right;flex-shrink:0;width:48px}
    .intent-conv{font-size:11px;color:var(--text3);text-align:right;width:60px;flex-shrink:0}

    /* HEATMAP */
    .heatmap-grid{display:grid;grid-template-columns:44px repeat(24,1fr);gap:2px;font-size:9.5px}
    .hm-cell{border-radius:4px;height:27px;display:flex;align-items:center;justify-content:center;font-weight:600;font-size:9.5px}
    .hm-label{color:var(--text3);font-size:9.5px;display:flex;align-items:center;justify-content:flex-end;padding-right:6px}
    .hm-hour-label{color:var(--text3);font-size:9px;display:flex;align-items:center;justify-content:center}

    @media(max-width:1100px){
      .kpi-grid{grid-template-columns:repeat(3,1fr)}
      .row-65{grid-template-columns:1fr}
      .reco-grid{grid-template-columns:1fr}
    }
    @media(max-width:800px){
      .row-2,.row-3,.version-grid{grid-template-columns:1fr}
      .kpi-grid{grid-template-columns:repeat(2,1fr)}
    }
  </style>
</head>
